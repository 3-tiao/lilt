# Go binary and pinned local prerelease (never commit signed bundles or user builds)
/lilt
/.lilt-prerelease/

# Nix build output symlink (flake.nix)
/result

# Release artifacts
/dist/

# Swift Package Manager and Xcode build output
/player/.build/
/player/Build/
/player/.swiftpm/

# Generated from player/project.yml by `just player-project`
/player/LiltPlayer.xcodeproj/

# macOS
.DS_Store

# Local just-command usage tally, written by scripts/just-tracker (see `just usage`)
/.just-usage.tsv

