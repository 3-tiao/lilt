package main

import (
	"context"
	"encoding/json"
	"fmt"
	"os"
	"time"

	"github.com/caiguo/lilt/internal/api"
)

func main() {
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()
	response, err := api.Command(ctx, api.SocketPath(), "library.albums", map[string]any{"source": "apple-music"})
	if err != nil {
		fmt.Println("transport:", err)
		os.Exit(1)
	}
	if !response.OK {
		fmt.Printf("error: %s %s\n", response.Error.Code, response.Error.Message)
		os.Exit(1)
	}
	var items []map[string]any
	_ = json.Unmarshal(response.Data, &items)
	fmt.Println("albums:", len(items))
	for i, it := range items {
		if i >= 5 {
			break
		}
		fmt.Println(" ", it["kind"], "|", it["title"], "|", it["artist"], "|", it["ref"])
	}
	if len(items) > 0 {
		ref := items[0]["ref"].(string)
		play, err := api.Command(ctx, api.SocketPath(), "playback.play", map[string]any{"ref": ref})
		if err != nil {
			fmt.Println("play transport:", err)
			os.Exit(1)
		}
		if !play.OK {
			fmt.Printf("play error: %s %s\n", play.Error.Code, play.Error.Message)
			os.Exit(1)
		}
		var st struct {
			Status string `json:"status"`
			Track  *struct {
				Title string `json:"title"`
				Kind  string `json:"kind"`
			} `json:"track"`
		}
		_ = json.Unmarshal(play.Data, &st)
		fmt.Printf("play: status=%s kind=%s title=%s\n", st.Status, st.Track.Kind, st.Track.Title)
	}
}
